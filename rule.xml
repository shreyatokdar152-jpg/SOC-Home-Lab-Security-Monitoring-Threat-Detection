<!--
  Custom rule: SSH brute-force detection
  File:  local_rules.xml  (append inside your existing <group> block, or as its own group)
  Path:  /var/ossec/etc/rules/local_rules.xml
  Author: <your name>
  MITRE ATT&CK: T1110.001 - Brute Force: Password Guessing

  Fires when 6+ SSH authentication failures (default rule 5716) are seen
  from the SAME source IP within a 120-second window.
-->
<group name="local,syscheck,ssh,brute_force,">

  <rule id="100010" level="10" frequency="6" timeframe="120">
    <if_matched_sid>5716</if_matched_sid>
    <same_source_ip />
    <description>SSH brute force attack detected: 6+ failed logins from the same source IP in 120 seconds</description>
    <mitre>
      <id>T1110.001</id>
    </mitre>
    <group>authentication_failures,pci_dss_10.2.4,pci_dss_10.2.5,pci_dss_10.6.1,gpg13_7.1,gdpr_IV_35.7.d,gdpr_IV_32.2,hipaa_164.312.b,nist_800_53_AU.14,nist_800_53_AC.7,tsc_CC6.1,tsc_CC6.8,tsc_CC7.2,tsc_CC7.3,</group>
  </rule>

</group>
